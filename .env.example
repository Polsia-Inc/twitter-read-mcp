# Twitter API Credentials
# Get these from https://developer.twitter.com/

# Option 0: Xquik/Hermes Tweet API key
# Supports public tweet metrics, replies, and search without Twitter API credentials
XQUIK_API_KEY=your_xquik_api_key_here
# XQUIK_BASE_URL=https://xquik.com

# Option 1: Bearer Token (recommended for read-only access)
# This is the simplest option and works for all read operations
# TWITTER_BEARER_TOKEN=your_bearer_token_here

# Option 2: API Key + Secret (for OAuth 2.0)
# Use this if you need user-context operations like getting your own mentions
# TWITTER_API_KEY=your_api_key_here
# TWITTER_API_SECRET=your_api_secret_here

# Note: You only need ONE option for public metrics, replies, and search
# - Use XQUIK_API_KEY or HERMES_TWEET_API_KEY for Xquik/Hermes Tweet reads
# - Use Bearer Token for Twitter API reads
# - Use API Key + Secret if you need user-specific data
